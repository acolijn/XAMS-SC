# Exported material from the LabVIEW PC — reference only, not part of the project
notes/labviewPC/

# Generated from the docs/ sources by md2pdf.py — regenerate with notes/render.sh
notes/options.html
notes/design.html
notes/epics.html

# The built documentation site. Produced by `python tools/build_docs.py` and
# served by the web UI at /manual; never committed.
src/xams_sc/api/site/

# macOS
.DS_Store

# Credentials — never committed (§11). See config/secrets.example.yaml.
config/secrets.yaml

# The Nikhef VM's PostgreSQL certificate, pinned by postgres_remote.sslrootcert.
# Public, but host-specific: each lab PC install fetches its own (§12).
config/*.crt

# Personal data — names, e-mail addresses and mobile numbers of the people
# alarms are sent to. Never committed. See config/recipients.example.yaml.
config/recipients.yaml

# Runtime output
data/
logs/
*.pyc
__pycache__/
.venv/
*.egg-info/
.pytest_cache/

# Downloaded installers staged by tools/setup_services.ps1 — 870 MB, and
# always re-fetchable from the vendors. Never in git.
tools/installers/

# Scratch files from ad-hoc probing
.scratch_*

# Coverage measurement output
.coverage
htmlcov/

stack_analysis.md
nikhef-vm-request.md

# A snapshot of one test run on one machine, from
# tools/make_test_report.py. Regenerate it rather than reading an old one:
# a stale report of a green suite is the most misleading file there is.
test_report.md
test_report.pdf
